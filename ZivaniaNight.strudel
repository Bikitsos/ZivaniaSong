// Zivania Night — Cypriot tavern party in D hijaz (phrygian dominant), 100 BPM
setcps(100/60/4)

// doumbek / tsifteteli groove: dum . . dum tek . tek .
$: stack(
  s("bd ~ ~ bd ~ ~ bd ~").bank("RolandTR808").gain(0.9),
  s("~ ~ ~ ~ rim ~ rim ~").bank("RolandTR808").gain(0.7).room(0.2),
  s("~ cp ~ ~ ~ cp ~ ~").bank("RolandTR808").gain(0.5).room(0.3).mask("<0 1 1 1>"),
  s("hh*8").bank("RolandTR808").gain(0.3).degradeBy(0.2),
  s("~ ~ ~ ~ ~ ~ ~ [rim rim]").bank("RolandTR808").gain(0.5).mask("<0 0 0 1>")
)

// bass: drone on the root, walking to the 5th and 4th
$: note("<d2 d2 [d2 a2] [g2 a2]>")
  .s("triangle")
  .struct("x ~ x x ~ x x ~")
  .lpf(500)
  .gain(0.8)

// bouzouki: tremolo-picked melody, call and response
$: n("<[0 1 2 3 2 1 0 ~] [2 3 4 3 2 1 2 ~] [4 5 4 3 2 1 0 1] [0 ~ 1 ~ 0 -1 0 ~]>")
  .scale("D3:phrygian:dominant")
  .s("sawtooth")
  .struct("x*8")
  .lpf(2500)
  .decay(0.12)
  .sustain(0)
  .room(0.35)
  .gain(0.45)
  .pan(sine.range(0.4, 0.6))
  .every(4, x => x.add(n(7)))

// baglama-style strummed chords on the offbeats
$: n("<[0,2,4] [0,2,4] [-2,0,2] [-1,1,3]>")
  .scale("D3:phrygian:dominant")
  .s("triangle")
  .struct("~ x ~ x ~ x ~ x")
  .decay(0.2)
  .sustain(0)
  .lpf(2000)
  .room(0.3)
  .gain(0.35)
  .mask("<0 1 1 1>/2")

// clarinet / violin-like lead soaring over the top, enters in the second half
$: n("<[7 ~ 8 9 ~ 8 7 ~] [9 ~ 10 11 ~ 10 9 7] [11 ~ 10 9 8 7 ~ ~] [7 ~ ~ ~ 0 ~ ~ ~]>")
  .scale("D3:phrygian:dominant")
  .s("sawtooth")
  .lpf(2800)
  .attack(0.03)
  .release(0.4)
  .vib(5)
  .vibmod(0.4)
  .delay(0.3)
  .delaytime(0.3)
  .delayfeedback(0.4)
  .room(0.5)
  .gain(0.3)
  .mask("<0 0 1 1>/2")
